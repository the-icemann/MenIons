# Copy to .env. Never commit .env.

# development | test | production
ENV=development
DATABASE_URL=postgresql+psycopg://menions:menions@localhost:5432/menions

# Public address of this service, used in receipt links.
PUBLIC_BASE_URL=http://localhost:8000

# --- WhatsApp outbound -------------------------------------------------
# fake (records messages, sends nothing) | kapso | meta
WHATSAPP_PROVIDER=fake
# Leave empty to use the provider's default:
#   kapso: https://api.kapso.ai/meta/whatsapp/v24.0
#   meta:  https://graph.facebook.com/v24.0
WHATSAPP_API_BASE=
WHATSAPP_PHONE_NUMBER_ID=
KAPSO_API_KEY=
META_ACCESS_TOKEN=

# --- WhatsApp webhook --------------------------------------------------
# none (development only; refused when ENV=production) | kapso | meta
WHATSAPP_WEBHOOK_SIGNATURE=none
KAPSO_WEBHOOK_SECRET=
META_APP_SECRET=
# Any long random string; typed into the provider's webhook setup screen.
WHATSAPP_VERIFY_TOKEN=

# --- Printed on every receipt -------------------------------------------
COMPANY_NAME=Men-Ions
COMPANY_TIN=
COMPANY_ADDRESS=Kampala, Uganda
COMPANY_PHONE=

# --- Bots ----------------------------------------------------------------
# Admin phones (comma-separated). Their messages starting with "/" are admin commands
# (send /help), and they receive alerts on WhatsApp.
ADMIN_PHONES=
# The business WhatsApp number as digits (2567...), used in click-to-chat links for customers.
WHATSAPP_DISPLAY_NUMBER=
# Where merchants pay for plans.
MOMO_PAY_NUMBER=
MOMO_PAY_NAME=
# Approved template (one body parameter) for messages outside the 24-hour window.
# Empty: those messages are skipped and an admin alert is recorded instead.
WHATSAPP_UPDATE_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Where pickup and delivery photos are saved.
MEDIA_DIR=var/media

# --- Plan payments ---------------------------------------------------------
# manual: merchants send Mobile Money by hand; an admin approves with /approve REF.
# pawapay: merchants get a PIN prompt on their phone and the plan starts the moment
#          pawaPay confirms. The hand-payment route stays available as a fallback.
PAYMENTS_PROVIDER=manual
PAWAPAY_API_TOKEN=
# Sandbox while testing. Production: https://api.pawapay.io
PAWAPAY_API_BASE=https://api.sandbox.pawapay.io
# Optional long random string. If set, the callback URL in pawaPay's dashboard must end in ?k=<it>
PAWAPAY_CALLBACK_TOKEN=

# --- EFRIS (URA e-receipts) --------------------------------------------------
# manual: admins issue the e-receipt on URA's portal, then send /fdn REF FDN CODE.
# fake:   made-up FDNs for development (refused when ENV=production).
EFRIS_PROVIDER=manual
# Admins are alerted when a sale has waited this many hours for its FDN (URA allows 24).
EFRIS_ALERT_HOURS=12

# --- Privacy -----------------------------------------------------------------
# Customers' pins and directions, parcel photos and raw messages are deleted this many
# days after an order closes. Receipts and payment records are kept.
DATA_RETENTION_DAYS=90
# Shown in the privacy notice (/privacy) as the contact for data requests. Defaults to COMPANY_PHONE.
PRIVACY_CONTACT=
