# Copy to .env. Never commit .env.

# development | test | production
ENV=development
DATABASE_URL=postgresql+psycopg://menions:menions@localhost:5432/menions

# Public address of this service, used in receipt links.
PUBLIC_BASE_URL=http://localhost:8000

# --- WhatsApp outbound -------------------------------------------------
# fake (records messages, sends nothing) | kapso | meta
WHATSAPP_PROVIDER=fake
# Leave empty to use the provider's default:
#   kapso: https://api.kapso.ai/meta/whatsapp/v24.0
#   meta:  https://graph.facebook.com/v24.0
WHATSAPP_API_BASE=
WHATSAPP_PHONE_NUMBER_ID=
KAPSO_API_KEY=
META_ACCESS_TOKEN=

# --- WhatsApp webhook --------------------------------------------------
# none (development only; refused when ENV=production) | kapso | meta
WHATSAPP_WEBHOOK_SIGNATURE=none
KAPSO_WEBHOOK_SECRET=
META_APP_SECRET=
# Any long random string; typed into the provider's webhook setup screen.
WHATSAPP_VERIFY_TOKEN=

# --- Printed on every receipt -------------------------------------------
COMPANY_NAME=Men-Ions
COMPANY_TIN=
COMPANY_ADDRESS=Kampala, Uganda
COMPANY_PHONE=
